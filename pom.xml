<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" child.project.url.inherit.append.path="false"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Boot's dependency and plugin versions for every module (ARCHITECTURE §16) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- resolve from the repository, not from ../pom.xml -->
    </parent>

    <groupId>dev.priceforge</groupId>
    <artifactId>priceforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PriceForge</name>
    <description>Parent POM: shared versions and build configuration for all modules</description>

    <!-- Project metadata: without these, every module inherits Spring Boot's
         (Apache 2.0 license, spring.io URL, Spring as developer) from the Boot parent.
         The append.path attributes (on <project> and <scm>) stop Maven adding
         "/<artifactId>" to these URLs in each module. -->
    <url>https://github.com/Dabbin-Giraffe/priceforge</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/MIT</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Dabbin-Giraffe</id>
            <name>Shashank Kathury</name>
            <url>https://github.com/Dabbin-Giraffe</url>
        </developer>
    </developers>
    <scm child.scm.url.inherit.append.path="false"
         child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false">
        <url>https://github.com/Dabbin-Giraffe/priceforge</url>
        <connection>scm:git:https://github.com/Dabbin-Giraffe/priceforge.git</connection>
        <developerConnection>scm:git:git@github.com:Dabbin-Giraffe/priceforge.git</developerConnection>
    </scm>

    <!-- <modules> arrive with the first module, contracts (PF-014) -->

    <modules>
        <module>contracts</module>
        <module>pricing-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- A BOM import only works here, never under <dependencies> -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
